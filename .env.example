# ===== LLM（OpenAI 兼容接口：DeepSeek / 通义 / Kimi / OpenAI 均可）=====
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-chat
# 单次 LLM 请求超时（毫秒），默认 60000；防对端半挂导致对话卡死
LLM_TIMEOUT_MS=60000

# ===== 服务监听地址与端口（WebChat: http://localhost:18790/webchat）=====
# HOST 默认 0.0.0.0（监听所有接口）；公网反向代理本地监听可设为 127.0.0.1
HOST=0.0.0.0
PORT=18790

# ===== 多用户体系（S4-1）=====
# SESSION_TTL_HOURS：登录会话有效期，默认 168 小时（7 天）
# BCRYPT_ROUNDS：密码哈希成本因子，默认 12
# LOGIN_RATE_LIMIT_MAX / WINDOW_MS：同一 IP 登录失败次数上限与窗口，默认 5 次/60 秒
SESSION_TTL_HOURS=168
BCRYPT_ROUNDS=12
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=60000

# ===== WebChat 访问口令（旧共享口令，S4-1 后不再作为常规 API 鉴权）=====
# 保留仅作系统启动/管理员 bootstrap 用途；日常请使用注册/登录接口获取 session token。
ACCESS_TOKEN=please-change-me

# ===== 数据源：eastmoney（内置直连）| python（需启动 data-service）=====
DATA_PROVIDER=eastmoney
PYTHON_SERVICE_URL=http://127.0.0.1:8000

# ===== 数据存储目录（SQLite store.db）=====
DATA_DIR=./data

# ===== 异动提醒：盘中轮询自选股，涨跌幅超阈值主动推送 =====
ALERT_ENABLED=true
ALERT_THRESHOLD_PCT=5
ALERT_INTERVAL_MINUTES=5

# ===== 收盘日报：是否附加技术面信号摘要（金叉/超买等客观状态描述，复用 F5-1 指标端点）=====
# true = 附加（需 data-service 运行，未运行时日报照常推送、信号区显示降级说明）
DAILY_REPORT_SIGNALS=true

# ===== 盘前外盘推送（F6-4，可选，默认关闭）=====
# true = 交易日约 9:10（北京时间）向有自选股/有监控规则的用户推送隔夜外盘摘要
#        + A 股相关方向提示（需 data-service 运行；外盘数据仅作参考，不构成投资建议）
OVERSEAS_PUSH_ENABLED=false

# ===== 选股扫描（F5-5，需 data-service 运行）=====
# SCANNER_AUTO_UPDATE：true（默认）= 交易日约 15:40（北京时间）自动触发 data-service
#   盘后增量更新本地日 K 库；false = 只手动更新（网页 /scanner 的"立即更新"按钮或
#   POST /api/scanner/update）
# SCANNER_PUSH_ENABLED：true = 更新完成后向有自选股/有监控规则的用户推送扫描摘要
#   （默认关闭；推送的是客观指标条件命中名单，不构成投资建议）
SCANNER_AUTO_UPDATE=true
SCANNER_PUSH_ENABLED=false

# ===== 交易日历（收盘日报/异动提醒跳过法定节假日）=====
# true = 从 data-service 拉交易日历，春节/国庆等休市日不推送；
#        data-service 不可用时自动降级为"只跳周末"（不会停止推送）
# false = 不查询日历，仅按周末判断（法定节假日照常推送）
TRADE_CALENDAR_ENABLED=true

# ===== 行情健康探针（定时探测常青股票，连续失败判定链路故障，状态见 /health 与服务日志）=====
HEALTH_PROBE_ENABLED=true
HEALTH_PROBE_INTERVAL_MINUTES=30
HEALTH_PROBE_CODE=600519
# 故障/恢复是否主动推送到聊天端。默认 false：对客户端透明，用户查询失败时对话内当场提示；
# true = 恢复旧行为（故障/恢复各推一条消息给所有用户）
HEALTH_PROBE_ALERT_PUSH=false

# ===== 飞书渠道（可选，默认关闭）=====
ENABLE_FEISHU=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
# 事件订阅开启"加密策略"后必填，用于 X-Lark-Signature 验签；公网部署强烈建议配置
FEISHU_ENCRYPT_KEY=

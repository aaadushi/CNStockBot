# ===== LLM（OpenAI 兼容接口：DeepSeek / 通义 / Kimi / OpenAI 均可）=====
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-chat

# ===== 服务端口（WebChat: http://localhost:18790/webchat）=====
PORT=18790

# ===== 数据源：eastmoney（内置直连）| python（需启动 data-service）=====
DATA_PROVIDER=eastmoney
PYTHON_SERVICE_URL=http://127.0.0.1:8000

# ===== 数据存储目录（JSON 文件存储）=====
DATA_DIR=./data

# ===== 飞书渠道（可选，默认关闭）=====
ENABLE_FEISHU=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
